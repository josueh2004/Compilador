import java_cup.runtime.*;
import Arbol.*;
import java.util.*;
import Analizador_Semantico.TipoDato;

parser code {:
    public StringBuilder erroresSintacticos = new StringBuilder();
    private final Stack<String> pilaEstructuras = new Stack<>();

    private void reportError(String mensaje, Symbol s, String sugerencia) {
        int linea = (s != null && s.left >= 0) ? s.left + 1 : -1;
        int columna = (s != null && s.right >= 0) ? s.right + 1 : -1;
        String lexema = (s != null && s.value != null) ? s.value.toString() : "EOF";
        
        String errorMsg = "Error sintáctico en línea " + linea + ", columna " + columna + 
                         " → encontrado: '" + lexema + "'\n   → " + mensaje;
        if (sugerencia != null && !sugerencia.isEmpty()) {
            errorMsg += "\n   → Sugerencia: " + sugerencia;
        }
        
        erroresSintacticos.append(errorMsg).append("\n");
    }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            reportError(message, s, generarSugerencia((Symbol) info));
        } else {
            erroresSintacticos.append("Error sintáctico: " + message + "\n");
        }
    }

    @Override
    public void syntax_error(Symbol s) {
        String lexema = (s != null && s.value != null) ? s.value.toString() : "EOF";
        String sugerencia = generarSugerencia(s);
        reportError("Símbolo inesperado", s, sugerencia);
    }
    
    private String generarSugerencia(Symbol s) {
        if (s == null) return "";
        String lexema = s.value != null ? s.value.toString() : "";
        
        if (lexema.equals(";")) {
            return "Falta una instrucción antes del ';'";
        } else if (lexema.equals("{")) {
            return "Se esperaba una instrucción antes de '{'";
        } else if (lexema.equals("}")) {
            return "Falta ';' al final de la instrucción anterior o hay '}'  sin '{'";
        } else if (lexema.equals("else")) {
            return "'else' sin 'if' previo";
        } else if (lexema.equals("EOF")) {
            return "Fin de archivo inesperado - verifica que todas las estructuras estén cerradas";
        }
        return "";
    }
:};

/* TERMINALES */
terminal BOOLEAN, STRING, ELSE, FLOAT, FOR, INT, IF, RETURN, VOID, WHILE, MAIN, PRINT, READ;
terminal TRUE, FALSE, NUMERO, STRING_LITERAL, NUMERO_REAL;
terminal ASIGNACION, MAYOR, MENOR, NEGACION, COMPARACION, MAYORIGUAL, MENORIGUAL, AND, OR;
terminal INCREMENTO, DECREMENTO, OPE_SUMA, OPE_RESTA, OPE_MULT, OPE_DIV;
terminal IN_PAREN, FIN_PAREN, IN_LLAVE, FIN_LLAVE, IN_CORCH, FIN_CORCH, TERMINADOR, COMMA;
terminal ID;
terminal ERROR;

/* NO TERMINALES */
non terminal Nodo_Programa programa;
non terminal java.util.List<Nodo_Metodo> metodos;
non terminal Nodo_Metodo metodo;
non terminal java.util.List<Nodo_Parametro> parametros, listaParametros;
non terminal java.util.List<Nodo_Instruccion> instrucciones;
non terminal Nodo_Instruccion instruccion;
non terminal Nodo_DeclaracionVariable declVariable;
non terminal Nodo_If declIf;
non terminal Nodo_While declWhile;
non terminal Nodo_For declFor;
non terminal Nodo_ExpresionST declIncrementoDecremento;
non terminal Nodo_Print declImprimir;
non terminal Nodo_Read declLeer;
non terminal Nodo_Return declRetorno;
non terminal Nodo_Asignacion declAsignacion;
non terminal Nodo_DeclaracionArray declArray;
non terminal Nodo_Expresion expresion, expresionOr, expresionAnd, expresionRelacional;
non terminal Nodo_Expresion expresionAritmetica, termino, expresionUnaria, primario;
non terminal Nodo_Expresion valLocalizable;
non terminal Nodo_LlamaMetodo llamarMetodo;
non terminal java.util.List<Nodo_Expresion> listaParametrosCall;
non terminal Nodo_Instruccion inicioFor;
non terminal Nodo_Instruccion pasoFor;
non terminal TipoDato tipo, tipoRetorno;

/* PRECEDENCIA */
precedence left OR;
precedence left AND;
precedence left COMPARACION, MAYOR, MENOR, MAYORIGUAL, MENORIGUAL;
precedence left OPE_SUMA, OPE_RESTA;
precedence left OPE_MULT, OPE_DIV;
precedence right NEGACION;

start with programa;

/* ============ PROGRAMA ============ */
programa ::= MAIN IN_LLAVE instrucciones:lista FIN_LLAVE metodos:mets
        {: RESULT = new Nodo_Programa(lista, mets); :}
    | MAIN error FIN_LLAVE
        {: 
            parser.erroresSintacticos.append("Error sintáctico: Cuerpo de main inválido\n");
            RESULT = new Nodo_Programa(new ArrayList<>(), new ArrayList<>());
        :}
;

/* ============ MÉTODOS ============ */
metodos ::= metodo:m metodos:resto
        {: resto.add(0, m); RESULT = resto; :}
    | {: RESULT = new ArrayList<>(); :}
;

metodo ::= tipoRetorno:tr ID:id IN_PAREN parametros:params FIN_PAREN IN_LLAVE instrucciones:insts FIN_LLAVE
        {: RESULT = new Nodo_Metodo(tr, (String)id, params, insts); :}
;

tipoRetorno ::= VOID {: RESULT = TipoDato.VOID; :}
              | tipo:t {: RESULT = t; :}
;

tipo ::= INT {: RESULT = TipoDato.INT; :}
       | FLOAT {: RESULT = TipoDato.FLOAT; :}
       | BOOLEAN {: RESULT = TipoDato.BOOLEAN; :}
       | STRING {: RESULT = TipoDato.STRING; :}
;

parametros ::= {: RESULT = new ArrayList<>(); :}
             | listaParametros:lp {: RESULT = lp; :}
;

listaParametros ::= tipo:t ID:id
                   {: ArrayList<Nodo_Parametro> l = new ArrayList<>();
                      l.add(new Nodo_Parametro((String)id, t));
                      RESULT = l; :}
                 | tipo:t ID:id COMMA listaParametros:resto
                   {: resto.add(0, new Nodo_Parametro((String)id, t)); RESULT = resto; :}
;

/* ============ INSTRUCCIONES ============ */
instrucciones ::= instruccion:i instrucciones:resto
    {: if(i != null) { resto.add(0, i); } RESULT = resto; :}
  | {: RESULT = new ArrayList<>(); :}
;

instruccion ::= declVariable:dv {: RESULT = dv; :}
             | declIf:di {: RESULT = di; :}
             | declWhile:dw {: RESULT = dw; :}
             | declFor:df {: RESULT = df; :}
             | declImprimir:dimp {: RESULT = dimp; :}
             | declRetorno:dr {: RESULT = dr; :}
             | declLeer:dl {: RESULT = dl; :}
             | declAsignacion:da {: RESULT = da; :}
             | declIncrementoDecremento:did {: RESULT = did; :}
             | declArray:dar {: RESULT = dar; :}
             | llamarMetodo:lm TERMINADOR {: RESULT = new Nodo_ExpresionST(lm); :}
             | error TERMINADOR
               {: RESULT = null; :}
             | error
               {: RESULT = null; :}
;

/* ============ DECLARACIÓN DE VARIABLE ============ */
declVariable ::= tipo:t ID:id TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 1);
       RESULT = new Nodo_DeclaracionVariable(t, (String)id, null, s.left + 1, s.right + 1); :}
  | tipo:t ID:id ASIGNACION expresion:exp TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 1);
       RESULT = new Nodo_DeclaracionVariable(t, (String)id, exp, s.left + 1, s.right + 1); :}
  | tipo:t ID:id ASIGNACION expresion:exp error
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
           .append(", columna ").append(s.right + 1).append(" → encontrado: '")
           .append(s.value != null ? s.value.toString() : "EOF").append("'\n")
           .append("   → Falta ';' al final de la declaración de variable\n");
       RESULT = new Nodo_DeclaracionVariable(t, (String)id, exp, s.left + 1, s.right + 1); :}
;

/* ============ ASIGNACIÓN ============ */
declAsignacion ::= valLocalizable:vl ASIGNACION expresion:exp TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Asignacion(vl, exp, s.left + 1, s.right + 1); :}
  | valLocalizable:vl ASIGNACION expresion:exp error
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
           .append(", columna ").append(s.right + 1).append(" → encontrado: '")
           .append(s.value != null ? s.value.toString() : "EOF").append("'\n")
           .append("   → Falta ';' después de la asignación\n");
       RESULT = new Nodo_Asignacion(vl, exp, s.left + 1, s.right + 1); :}
;

/* ============ IF ============ */
declIf ::= IF IN_PAREN expresion:cond FIN_PAREN IN_LLAVE instrucciones:inst FIN_LLAVE
        {: RESULT = new Nodo_If(cond, inst, null); :}
      | IF IN_PAREN expresion:cond FIN_PAREN IN_LLAVE instrucciones:inst FIN_LLAVE ELSE IN_LLAVE instrucciones:elseInst FIN_LLAVE
        {: RESULT = new Nodo_If(cond, inst, elseInst); :}
      | IF error IN_LLAVE instrucciones:inst FIN_LLAVE
        {: Symbol s = (Symbol)CUP$Parser$stack.peek();
           parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
               .append(", columna ").append(s.right + 1).append(" → Condición inválida en if\n");
           RESULT = new Nodo_If(null, inst, null); :}
;

/* ============ WHILE ============ */
declWhile ::= WHILE IN_PAREN expresion:cond FIN_PAREN IN_LLAVE instrucciones:insts FIN_LLAVE
              {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 4);
                 RESULT = new Nodo_While(cond, insts, s.left + 1, s.right + 1); :}
           | WHILE IN_PAREN error FIN_PAREN IN_LLAVE instrucciones:insts FIN_LLAVE
              {: Symbol s = (Symbol)CUP$Parser$stack.peek();
                 parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
                     .append(", columna ").append(s.right + 1)
                     .append(" → Condición inválida en while\n");
                 RESULT = null; :}
;

/* ============ FOR ============ */
declFor ::= FOR IN_PAREN inicioFor:ini expresion:cond TERMINADOR pasoFor:paso FIN_PAREN IN_LLAVE instrucciones:insts FIN_LLAVE
            {: Symbol s = (Symbol)CUP$Parser$stack.peek();
               RESULT = new Nodo_For(ini, cond, paso, insts, s.left + 1, s.right + 1); :}
         | FOR IN_PAREN error FIN_PAREN IN_LLAVE instrucciones:insts FIN_LLAVE
            {: Symbol s = (Symbol)CUP$Parser$stack.peek();
               parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
                   .append(", columna ").append(s.right + 1)
                   .append(" → Cabecera del for inválida\n");
               RESULT = null; :}
;

inicioFor ::= TERMINADOR {: RESULT = null; :}
           | declVariable:dv {: RESULT = dv; :}
           | declAsignacion:da {: RESULT = da; :}
;

pasoFor ::= {: RESULT = null; :}
         | expresion:exp {: RESULT = (Nodo_Instruccion)exp; :}
;

/* ============ PRINT ============ */
declImprimir ::= PRINT IN_PAREN expresion:exp FIN_PAREN TERMINADOR
    {: RESULT = new Nodo_Print(exp); :}
  | PRINT IN_PAREN error FIN_PAREN TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
           .append(", columna ").append(s.right + 1)
           .append(" → Expresión inválida en print\n");
       RESULT = null; :}
;

/* ============ READ ============ */
declLeer ::= READ IN_PAREN ID:id FIN_PAREN TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Read(new Nodo_Identificador((String)id, s.left + 1, s.right + 1)); :}
;

/* ============ RETURN ============ */
declRetorno ::= RETURN TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 1);
       RESULT = new Nodo_Return(null, s.left + 1, s.right + 1); :}
           | RETURN expresion:exp TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 1);
       RESULT = new Nodo_Return(exp, s.left + 1, s.right + 1); :}
;

/* ============ LOCALIZABLE ============ */
valLocalizable ::= ID:id
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Identificador((String)id, s.left + 1, s.right + 1); :}
  | ID:id IN_CORCH expresion:indice FIN_CORCH
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 3);
       ArrayList<Nodo_Expresion> ind = new ArrayList<>();
       ind.add(indice);
       Nodo_Identificador nid = new Nodo_Identificador((String)id, s.left + 1, s.right + 1);
       RESULT = new Nodo_AccesoArray(nid, ind, s.left + 1, s.right + 1); :}
;

/* ============ ARRAY ============ */
declArray ::= tipo:t ID:id IN_CORCH expresion:tam FIN_CORCH TERMINADOR
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 4);
       ArrayList<Nodo_Expresion> dims = new ArrayList<>();
       dims.add(tam);
       RESULT = new Nodo_DeclaracionArray(t, (String)id, dims, s.left + 1, s.right + 1); :}
;

/* ============ LLAMADA A MÉTODO ============ */
llamarMetodo ::= ID:id IN_PAREN listaParametrosCall:params FIN_PAREN
    {: Symbol s = (Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top - 3);
       String nombre = (String)s.value;
       RESULT = new Nodo_LlamaMetodo(new Nodo_Identificador(nombre, s.left + 1, s.right + 1), params, s.left + 1, s.right + 1); :}
;

listaParametrosCall ::= {: RESULT = new ArrayList<>(); :}
                     | expresion:exp
                       {: ArrayList<Nodo_Expresion> l = new ArrayList<>();
                          l.add(exp);
                          RESULT = l; :}
                     | expresion:exp COMMA listaParametrosCall:resto
                       {: resto.add(0, exp); RESULT = resto; :}
;

/* ============ EXPRESIONES ============ */
expresion ::= expresionOr:e {: RESULT = e; :};

expresionOr ::= expresionOr:e1 OR expresionAnd:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "||", e2, s.left + 1, s.right + 1); :}
  | expresionAnd:e {: RESULT = e; :}
;

expresionAnd ::= expresionAnd:e1 AND expresionRelacional:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "&&", e2, s.left + 1, s.right + 1); :}
  | expresionRelacional:e {: RESULT = e; :}
;

expresionRelacional ::= expresionAritmetica:e1 COMPARACION expresionAritmetica:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "==", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e1 MAYOR expresionAritmetica:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, ">", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e1 MENOR expresionAritmetica:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "<", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e1 MAYORIGUAL expresionAritmetica:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, ">=", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e1 MENORIGUAL expresionAritmetica:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "<=", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e {: RESULT = e; :}
;

expresionAritmetica ::= expresionAritmetica:e1 OPE_SUMA termino:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "+", e2, s.left + 1, s.right + 1); :}
  | expresionAritmetica:e1 OPE_RESTA termino:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "-", e2, s.left + 1, s.right + 1); :}
  | termino:e {: RESULT = e; :}
;

termino ::= termino:e1 OPE_MULT expresionUnaria:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "*", e2, s.left + 1, s.right + 1); :}
  | termino:e1 OPE_DIV expresionUnaria:e2
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpBinario(e1, "/", e2, s.left + 1, s.right + 1); :}
  | expresionUnaria:e {: RESULT = e; :}
;

expresionUnaria ::= OPE_RESTA primario:e
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpUnario("-", e, s.left + 1, s.right + 1); :}
  | NEGACION primario:e
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_OpUnario("!", e, s.left + 1, s.right + 1); :}
  | primario:e {: RESULT = e; :}
;

primario ::= NUMERO:n
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Numero((Integer)n, s.left + 1, s.right + 1); :}
  | NUMERO_REAL:r
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Float((Float)r, s.left + 1, s.right + 1); :}
  | TRUE
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Booleano(true, s.left + 1, s.right + 1); :}
  | FALSE
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_Booleano(false, s.left + 1, s.right + 1); :}
  | STRING_LITERAL:s
    {: Symbol sym = (Symbol)CUP$Parser$stack.peek();
       RESULT = new Nodo_StringLiteral((String)s, sym.left + 1, sym.right + 1); :}
  | valLocalizable:v {: RESULT = v; :}
  | llamarMetodo:lm {: RESULT = lm; :}
  | IN_PAREN expresion:e FIN_PAREN {: RESULT = e; :}
  | error
    {: Symbol s = (Symbol)CUP$Parser$stack.peek();
       parser.erroresSintacticos.append("Error sintáctico en línea ").append(s.left + 1)
           .append(", columna ").append(s.right + 1)
           .append(" → Expresión inválida\n");
       RESULT = null; :}
;

